-- NEW: Improved Trade Request Blocking Function - ONLY BLOCKS REAL REQUESTS
local function blockTradeRequests()
    if isVisualTradeActive then return end
    
    print("🛡️ Setting up trade request blocking...")
    
    local Fsys = require(game.ReplicatedStorage:WaitForChild("Fsys"))
    local UIManager = Fsys.load("UIManager")
    
    -- Store original function if not already stored
    if not originalDialogFunction then
        originalDialogFunction = UIManager.apps.DialogApp.dialog
    end
    
    -- Hook the dialog system to block ONLY REAL incoming trade requests
    UIManager.apps.DialogApp.dialog = function(self, options)
        -- Check if this is a REAL incoming trade request (from actual players)
        if options and options.text and string.find(string.lower(options.text), "sent you a trade request") then
            -- Check if this is OUR fake trade request (from our selected player)
            if options.text and string.find(options.text, selectedPlayerName) then
                print("✅ ALLOWING our fake trade request from: " .. selectedPlayerName)
                return originalDialogFunction(self, options) -- Allow our fake request
            else
                print("🚫 BLOCKED real incoming trade request while in visual trade mode")
                return "Decline" -- Auto-decline only REAL incoming requests
            end
        end
        -- Allow all other dialogs to work normally
        return originalDialogFunction(self, options)
    end
    
    isVisualTradeActive = true
    print("✅ REAL incoming trade requests BLOCKED - visual trade active")
end

-- NEW: Restore trade requests when trade ends
local function restoreTradeRequests()
    if not isVisualTradeActive then return end
    
    print("🛡️ Restoring trade requests...")
    
    local Fsys = require(game.ReplicatedStorage:WaitForChild("Fsys"))
    local UIManager = Fsys.load("UIManager")
    
    -- Restore dialog function
    if originalDialogFunction then
        UIManager.apps.DialogApp.dialog = originalDialogFunction
    end
    
    isVisualTradeActive = false
    print("✅ Trade requests RESTORED - visual trade ended")
end

