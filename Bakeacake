-- Function to completely destroy trade instead of just hiding
local function destroyTradeCompletely()
    if currentTradeApp then
        local TradeApp = currentTradeApp
        
        -- Restore original methods
        if originalAcceptHandler then
            TradeApp._on_accept_pressed = originalAcceptHandler
        end
        if originalUnacceptHandler then
            TradeApp._on_unaccept_pressed = originalUnacceptHandler
        end
        if originalConfirmHandler then
            TradeApp._on_confirm_pressed = originalConfirmHandler
        end
        if originalUnconfirmHandler then
            TradeApp._on_unconfirm_pressed = originalUnconfirmHandler
        end
        if originalHideHandler then
            TradeApp.hide = originalHideHandler
        end
        
        -- Clear the trade state completely
        TradeApp:_overwrite_local_trade_state(nil)
        
        -- Use original hide method to properly close
        if originalHideHandler then
            originalHideHandler(TradeApp)
        end
        
        currentTradeApp = nil
        isTradeActive = false
        
        -- RESTORE TRADE REQUESTS
        restoreTradeRequests()
        
        print("🗑️ Trade completely destroyed!")
    end
end

-- Function to setup fake reporting in trade history - PROPER FLOW
local function setupFakeReporting()
    if not _G.savedTradeHistory then return end
    
    for tradeId, tradeRecord in pairs(_G.savedTradeHistory) do
        -- Start with trades NOT reported (so report button is clickable)
        tradeRecord.reported = false
        
        -- Mark some trades as reverted for testing
        if math.random(1, 5) == 1 then -- 20% chance
            tradeRecord.reverted = {
                timestamp = os.time() - math.random(86400, 2592000) -- 1-30 days ago
            }
            print("🔄 Trade marked as reverted: " .. tradeId)
        else
            tradeRecord.reverted = false -- Ensure it's false if not reverted
        end
    end
end

-- Function to block real trade requests during visual trades
local function setupTradeRequestBlocking()
    local success, Fsys = pcall(function()
        return require(game.ReplicatedStorage:WaitForChild("Fsys"))
    end)
    
    if success then
        local UIManager = Fsys.load("UIManager")
        
        -- Store original trade request handler
        if UIManager and UIManager._on_trade_request then
            originalTradeRequestHandler = UIManager._on_trade_request
        end
        
        -- Override trade request handler
        UIManager._on_trade_request = function(self, fromPlayer, tradeId)
            if isTradeActive then
                print("🚫 Blocked real trade request from " .. fromPlayer.Name .. " (visual trade active)")
                return -- Block the request
            else
                print("✅ Allowing real trade request from " .. fromPlayer.Name)
                if originalTradeRequestHandler then
                    return originalTradeRequestHandler(self, fromPlayer, tradeId)
                end
            end
        end
        
        print("✅ Trade request blocking setup complete!")
    else
        print("⚠️ Could not setup trade request blocking")
    end
end

-- Function to set influencer stars in trade UI
local function setInfluencerStars(playerName)
    local startTime = tick()
    local maxWaitTime = 10
    
    local function attemptSetStars()
        local playerGui = player.PlayerGui
        local tradeApp = playerGui:FindFirstChild("TradeApp")
        
        if tradeApp and tradeApp:FindFirstChild("Frame") then
            local negotiationFrame = tradeApp.Frame:FindFirstChild("NegotiationFrame")
            if negotiationFrame and negotiationFrame:FindFirstChild("Header") then
                local partnerFrame = negotiationFrame.Header:FindFirstChild("PartnerFrame")
                if partnerFrame then
                    local nameLabel = partnerFrame:FindFirstChild("NameLabel")
                    if nameLabel then
                        -- Set the player name
                        nameLabel.Text = playerName
                        
                        -- Remove any existing star
                        local existingStar = partnerFrame:FindFirstChild("InfluencerStar")
                        if existingStar then
                            existingStar:Destroy()
                        end
                        
                        -- Add star icon for influencers
                        if playerName == "cammyxboba" or playerName == "rainbowriley321" then
                            local starIcon = Instance.new("ImageLabel")
                            starIcon.Name = "InfluencerStar"
                            starIcon.Size = UDim2.new(0, 20, 0, 20)
                            starIcon.Position = UDim2.new(1, 5, 0.5, -10)
                            starIcon.AnchorPoint = Vector2.new(0, 0.5)
                            starIcon.BackgroundTransparency = 1
                            starIcon.Image = "rbxassetid://5955103692"
                            starIcon.ImageColor3 = Color3.fromRGB(255, 215, 0)
                            starIcon.ZIndex = 10
                            starIcon.Parent = partnerFrame
                            
                            print("⭐ Influencer star added for " .. playerName)
                        end
                        
                        return true
                    end
                end
            end
        end
        
        return false
    end
    
    -- Try immediately
    if attemptSetStars() then
        return
    end
    
    -- If not ready, wait and retry
    local connection
    connection = game:GetService("RunService").Heartbeat:Connect(function()
        if attemptSetStars() then
            connection:Disconnect()
        elseif tick() - startTime > maxWaitTime then
            connection:Disconnect()
            warn("❌ Could not set influencer stars - timeout")
        end
    end)
end

