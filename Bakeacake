-- Hook into TradeHistoryApp with PROPER reporting flow
local function hookTradeHistoryApp()
    local success, TradeHistoryApp = pcall(function()
        return require(game.ReplicatedStorage.ClientModules.Core.UIManager.Apps.TradeHistoryApp)
    end)
    
    if success and TradeHistoryApp then
        local originalGetTradeHistory = TradeHistoryApp._get_trade_history
        TradeHistoryApp._get_trade_history = function(self, useCache)
            local originalHistory = originalGetTradeHistory(self, useCache)
            
            if _G.savedTradeHistory then
                originalHistory = originalHistory or {}
                
                -- Remove any existing visual trades to prevent duplicates
                for i = #originalHistory, 1, -1 do
                    if originalHistory[i] and string.find(tostring(originalHistory[i].trade_id), "visual_trade") then
                        table.remove(originalHistory, i)
                    end
                end
                
                -- Add our trades with proper timestamps (most recent first)
                local visualTrades = {}
                for _, tradeRecord in pairs(_G.savedTradeHistory) do
                    table.insert(visualTrades, tradeRecord)
                end
                
                -- Sort visual trades by timestamp (newest first)
                table.sort(visualTrades, function(a, b)
                    return (a.timestamp or 0) > (b.timestamp or 0)
                end)
                
                -- Insert visual trades at the beginning
                for i = #visualTrades, 1, -1 do
                    table.insert(originalHistory, 1, visualTrades[i])
                end
            end
            
            return originalHistory
        end
        
        -- Hook the report function to handle our fake reports with proper flow
        local originalReportScam = TradeHistoryApp.report_scam
        TradeHistoryApp.report_scam = function(self, tradeRecord)
            if tradeRecord and string.find(tostring(tradeRecord.trade_id), "visual_trade") then
                -- Handle fake report for our visual trades
                print("📋 Fake reporting visual trade: " .. tradeRecord.trade_id)
                
                -- Mark as reported in our saved history
                if _G.savedTradeHistory and _G.savedTradeHistory[tradeRecord.trade_id] then
                    _G.savedTradeHistory[tradeRecord.trade_id].reported = true
                    print("✅ Trade marked as reported in history!")
                end
                
                -- Show fake report success message
                self.UIManager.apps.DialogApp:dialog({
                    text = "Thanks for your report!",
                    button = "Close",
                    yields = false,
                })
                
                -- Refresh the trade history to show the updated state
                if self.instance.Frame.Visible then
                    self:_refresh()
                end
                
                return
            end
            
            -- Call original function for real trades
            if originalReportScam then
                return originalReportScam(self, tradeRecord)
            end
        end
        
        print("✅ Trade History App hooked with proper reporting flow!")
    else
        print("⚠️ Could not hook Trade History App")
    end
end

