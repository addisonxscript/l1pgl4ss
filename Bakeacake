        newX = math.clamp(newX, 0, screenSize.X - sidePanel.AbsoluteSize.X)
        newY = math.clamp(newY, 0, screenSize.Y - sidePanel.AbsoluteSize.Y)
        sidePanel.Position = UDim2.new(0, newX, 0, newY)
    end
end)
